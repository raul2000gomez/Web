rules_version = '2';

// cosas.info · reglas de Firestore para «Cosas con»
// Pégalas en Firebase → Firestore Database → Reglas y publica.
//
// Modelo:
//   listas/{id}              { nombre, tipo: 'con' | 'de', color, creada, creadaPor, uids: [uid], miembros: { uid: { nombre, color, desde } },
//                              ultima: { en, por, grupo } }   (la última cosa nueva: para el punto verde de las novedades)
//   listas/{id}/cosas/{cid}  { texto, hecha, creada, hechaEn, por, grupo }   (grupo: el id de uno de sus grupos, o null)
//   listas/{id}/grupos/{gid} { nombre, color, creada, por }                   (grupos de cosas dentro de la lista)
//   usuarios/{uid}           { nombre, color, actualizado, vistos: { idLista | 'idLista~idGrupo' | '_desde': cuándo } }
//   personales/{uid}/elementos/{id}   Las cosas de la app Cosas (cosas-app.netlify.app) de quien ha
//                            entrado con Google, para tenerlas en todos sus dispositivos (app/nube.js):
//                            { tipo: 'cosa', id, texto, hecha, creada, hechaEn, grupo }
//                            { tipo: 'grupo', id, nombre, color, creada }
//                            { tipo: 'ajustes', colorFondo, nombre }
//
// Cualquiera que tenga el enlace (y esté identificado, aunque sea de forma anónima) puede
// leer una lista y unirse a ella añadiéndose a sí mismo. Solo los miembros pueden ver y
// tocar sus cosas. De la gente, cada miembro solo toca lo suyo (su nombre, irse); quien creó
// la lista puede además sacar a otros. Solo quien la creó puede borrarla.
//
// «Cosas con» es para dos personas exactamente: una lista de tipo «con» nunca puede tener
// más de dos miembros (ni al unirse alguien, ni al cambiar el tipo de una lista mayor).

service cloud.firestore {
  match /databases/{database}/documents {

    function identificado() {
      return request.auth != null;
    }

    function esMiembro(datos) {
      return identificado() && ('uids' in datos) && (request.auth.uid in datos.uids);
    }

    function textoValido(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    function colorValido(v) {
      return v is string && v.matches('^#[0-9A-Fa-f]{6}$');
    }

    // «con» (con una persona) o «de» (un grupo alrededor de un tema).
    function tipoValido(v) {
      return v is string && v in ['con', 'de'];
    }

    // «Cosas con» es solo para dos; «Cosas de» no tiene límite.
    function dentroDelLimite(datos) {
      return datos.tipo != 'con' || datos.uids.size() <= 2;
    }

    // El grupo de una cosa: ninguno (null o sin el campo) o el id de uno de los grupos de su lista.
    function grupoDeCosaValido(d) {
      return !('grupo' in d) || d.grupo == null || textoValido(d.grupo, 40);
    }

    // Unirse: la única diferencia con la lista anterior es que uno mismo aparece en «uids» y en «miembros».
    function seUneASiMismo() {
      let antes = resource.data;
      let despues = request.resource.data;
      return despues.diff(antes).affectedKeys().hasOnly(['uids', 'miembros'])
        && despues.uids.hasAll(antes.uids)
        && despues.uids.size() == antes.uids.size() + 1
        && (request.auth.uid in despues.uids)
        && despues.miembros.diff(antes.miembros).affectedKeys().hasOnly([request.auth.uid]);
    }

    // Lo que un miembro puede cambiar de la gente de la lista: sus propios datos, irse él (sale de «uids» y de
    // «miembros») y, si es quien la creó, sacar a otros. Meter a alguien nunca: eso es unirse, cada uno a sí mismo.
    function cambioDeGenteValido() {
      let antes = resource.data;
      let despues = request.resource.data;
      let yo = request.auth.uid;
      let tocados = despues.miembros.diff(antes.miembros);
      return (despues.uids == antes.uids && tocados.affectedKeys().hasOnly([yo]))
        || (despues.uids == antes.uids.removeAll([yo]) && tocados.affectedKeys().hasOnly([yo]))
        || (yo == antes.creadaPor && antes.uids.hasAll(despues.uids) && tocados.addedKeys().size() == 0);
    }

    match /listas/{id} {
      allow get: if identificado();
      allow list: if esMiembro(resource.data);

      allow create: if identificado()
        && request.resource.data.creadaPor == request.auth.uid
        && request.resource.data.uids == [request.auth.uid]
        && textoValido(request.resource.data.nombre, 40)
        && tipoValido(request.resource.data.tipo)
        && dentroDelLimite(request.resource.data)
        && colorValido(request.resource.data.color);

      allow update: if identificado()
        && textoValido(request.resource.data.nombre, 40)
        && tipoValido(request.resource.data.tipo)
        && dentroDelLimite(request.resource.data)
        && colorValido(request.resource.data.color)
        && request.resource.data.creadaPor == resource.data.creadaPor
        && (seUneASiMismo() || (esMiembro(resource.data) && cambioDeGenteValido()));

      allow delete: if identificado() && resource.data.creadaPor == request.auth.uid;

      match /cosas/{cid} {
        function listaPadre() {
          return get(/databases/$(database)/documents/listas/$(id)).data;
        }

        allow read: if esMiembro(listaPadre());

        allow create: if esMiembro(listaPadre())
          && textoValido(request.resource.data.texto, 500)
          && request.resource.data.hecha is bool
          && grupoDeCosaValido(request.resource.data);

        allow update: if esMiembro(listaPadre())
          && textoValido(request.resource.data.texto, 500)
          && request.resource.data.hecha is bool
          && grupoDeCosaValido(request.resource.data);

        allow delete: if esMiembro(listaPadre());
      }

      // Los grupos de cosas de la lista: como sus cosas, solo para los miembros.
      match /grupos/{gid} {
        function listaDelGrupo() {
          return get(/databases/$(database)/documents/listas/$(id)).data;
        }

        allow read, delete: if esMiembro(listaDelGrupo());

        allow create, update: if esMiembro(listaDelGrupo())
          && textoValido(request.resource.data.nombre, 60)
          && (request.resource.data.color == null || colorValido(request.resource.data.color));
      }
    }

    match /usuarios/{uid} {
      allow read, write: if identificado() && request.auth.uid == uid;
    }

    // Tus cosas: solo tuyas, y con la forma que espera la app (los límites dejan margen a los de la
    // app: 500 caracteres por cosa y 60 por nombre, que en bytes pueden ser más).
    function numeroONulo(v) {
      return v == null || v is number;
    }

    function textoONulo(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    function cosaValida(d) {
      return d.keys().hasOnly(['tipo', 'id', 'texto', 'hecha', 'creada', 'hechaEn', 'grupo'])
        && textoValido(d.id, 200) && textoValido(d.texto, 2000) && d.hecha is bool
        && d.creada is number && numeroONulo(d.hechaEn) && textoONulo(d.grupo, 200);
    }

    function grupoValido(d) {
      return d.keys().hasOnly(['tipo', 'id', 'nombre', 'color', 'creada'])
        && textoValido(d.id, 200) && textoValido(d.nombre, 200)
        && (d.color == null || colorValido(d.color)) && d.creada is number;
    }

    function ajustesValidos(d) {
      return d.keys().hasOnly(['tipo', 'colorFondo', 'nombre'])
        && colorValido(d.colorFondo) && d.nombre is string && d.nombre.size() <= 200;
    }

    function elementoValido(d) {
      return (d.tipo == 'cosa' && cosaValida(d))
        || (d.tipo == 'grupo' && grupoValido(d))
        || (d.tipo == 'ajustes' && ajustesValidos(d));
    }

    match /personales/{uid}/elementos/{elemento} {
      allow read, delete: if identificado() && request.auth.uid == uid;
      allow create, update: if identificado() && request.auth.uid == uid && elementoValido(request.resource.data);
    }
  }
}
